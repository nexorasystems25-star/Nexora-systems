{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@nexora/ui": ["./packages/ui/src"],
      "@nexora/auth": ["./packages/auth/src"],
      "@nexora/billing": ["./packages/billing/src"],
      "@nexora/db": ["./packages/db/src"],
      "@nexora/config": ["./packages/config"],
      "@nexora/utils": ["./packages/utils/src"]
    }
  },
  "exclude": ["node_modules"]
}
